# Reserved for the Supabase and Gemini integration. Keep secret values on the server.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=
GEMINI_EMBEDDING_MODEL=
GEMINI_EMBEDDING_DIMENSIONS=

SOURCELEAF_CHUNK_CHARS=
SOURCELEAF_MATCH_COUNT=
SOURCELEAF_REQUEST_TIMEOUT_SECONDS=

# Must match the private Supabase bucket size limit in bytes.
SOURCELEAF_MAX_UPLOAD_BYTES=

# Background indexing settings. See README for example values.
SOURCELEAF_INGEST_BATCH_SIZE=
SOURCELEAF_INGEST_LEASE_SECONDS=
SOURCELEAF_INGEST_FAILURE_LIMIT=
SOURCELEAF_INGEST_RETRY_SECONDS=

# Global daily model-call budgets and a per-account budget.
SOURCELEAF_DAILY_DEMO_LIMIT=
SOURCELEAF_DAILY_AI_LIMIT=
SOURCELEAF_DAILY_AI_ACCOUNT_LIMIT=
SOURCELEAF_DAILY_INDEX_LIMIT=
SOURCELEAF_DAILY_UPLOADS_LIMIT=
SOURCELEAF_DAILY_UPLOADS_ACCOUNT_LIMIT=
SOURCELEAF_MAX_DOCUMENT_CHUNKS=
SOURCELEAF_SUMMARY_SECTIONS=
SOURCELEAF_SUMMARY_SECTION_CHARS=

# Hosted worker only. Use the same random worker token on both services.
SOURCELEAF_WORKFLOW_ORIGIN=
SOURCELEAF_WORKER_TOKEN=
