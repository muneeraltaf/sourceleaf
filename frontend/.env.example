# Optional local routing. Set this to the URL printed by Uvicorn.
LOCAL_API_ORIGIN=

# Supabase browser configuration. These values are public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hosted worker only. Keep these server-side.
SOURCELEAF_API_ORIGIN=
SOURCELEAF_WORKER_TOKEN=
